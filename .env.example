# Copy to .env.local (runtime secrets) and .env (DATABASE_URL for Prisma CLI).

# Database. Dev: SQLite file. Prod: Postgres connection string
# (and set schema.prisma `provider = "postgresql"`).
DATABASE_URL="file:./dev.db"

# Auth.js signing secret. Generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth client (https://console.cloud.google.com).
# Redirect URI (dev): http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
