# Copy to .env.local (runtime secrets) and .env (DATABASE_URL for Prisma CLI).

# Database. Dev: SQLite file. Prod: Postgres connection string
# (and set schema.prisma `provider = "postgresql"`).
DATABASE_URL="file:./dev.db"

# Auth.js signing secret. Generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth client (https://console.cloud.google.com).
# Redirect URI (dev): http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Online multiplayer. Set both to "true" and run `npm run dev:multi` (or
# `npm run start:multi` in production) to enable Socket.IO. Leave unset to
# keep multiplayer dark — the Lobby route, socket server, and nav link are
# all gated on these flags and incur zero overhead when absent.
MULTIPLAYER=""
NEXT_PUBLIC_MULTIPLAYER=""
